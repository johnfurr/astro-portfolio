            <animate attributeName="dx" keyTimes="0;0.1665;0.1707;0.2075;0.2601;0.8175;0.8488;1" values="0.0265;0.0292;0.0089;0.0094;0.0258;0.0199;0.0038;0.0080" begin="0s" dur="6.3545s" calcMode="discrete" repeatCount="indefinite" fill="freeze"/>
            <animate attributeName="dy" keyTimes="0;0.1665;0.1707;0.2075;0.2601;0.8175;0.8488;1" values="0.0265;0.0292;0.0089;0.0094;0.0258;0.0199;0.0038;0.0080" begin="0s" dur="6.3545s" calcMode="discrete" repeatCount="indefinite" fill="freeze"/>
        </feOffset>
        <feOffset in="blended" dx="0" dy="0" y="59%" height="14%" result="slice_4">
            <animate attributeName="dx" keyTimes="0;0.1082;0.2516;0.3391;0.4109;0.8416;0.9708;1" values="0.0088;0.0168;0.0150;0.0226;0.0235;0.0272;0.0175;0.0046" begin="0s" dur="6.4497s" calcMode="discrete" repeatCount="indefinite" fill="freeze"/>
            <animate attributeName="dy" keyTimes="0;0.1082;0.2516;0.3391;0.4109;0.8416;0.9708;1" values="0.0088;0.0168;0.0150;0.0226;0.0235;0.0272;0.0175;0.0046" begin="0s" dur="6.4497s" calcMode="discrete" repeatCount="indefinite" fill="freeze"/>
        </feOffset>

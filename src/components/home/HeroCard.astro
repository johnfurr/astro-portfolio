            <animate attributeName="dy" keyTimes="0;0.1605;0.2433;0.4041;0.5144;0.6092;0.7068;1" values="0.0171;0.0237;0.0104;0.0145;0.0162;0.0122;0.0234;0.0144" begin="0s" dur="6.1079s" calcMode="discrete" repeatCount="indefinite" fill="freeze"/>
        </feOffset>
